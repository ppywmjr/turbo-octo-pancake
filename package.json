{
  "name": "turbo-octo-pancake",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "mock": "node --experimental-strip-types mock-server/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "mutate:baseline": "node --experimental-strip-types scripts/update-mutation-baseline.ts",
    "mutate:compare": "node --experimental-strip-types scripts/compare-mutation-score.ts",
    "test:watch": "vitest",
    "ai:test:all": "vitest run tests 2>&1 | tail -30",
    "ai:test:unit": "vitest run tests/unit 2>&1 | tail -30",
    "ai:test:unit:verbose:fail": "pnpm vitest run tests/unit --reporter=verbose 2>&1 | grep -A 30 \"FAIL\"",
    "ai:coverage": "vitest run --coverage 2>&1 | tail -30",
    "ai:mutate": "stryker run 2>&1 | tail -80",
    "ai:mutate:survived": "pnpm run mutate 2>&1 | grep -A 5 \"\\[Survived\\]\""
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
